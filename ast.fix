module Ast;

import Main::main;

namespace Ast {
    type Ast = box union {
        number : (I64),
        binary_operation : (BinaryOperation),
        unary_operation : (UnaryOperation),
        // function_call : (FunctionCall),
        variable : (Variable),
    };

    // Operator
    type BinaryOperator = union {
        add : (),
        sub : (),
        mul : (),
        div : (),
        mod : (),
        assign : (),
        less : (),
        less_or_equal : (),
        greater : (),
        greater_or_equal : (),
        equal : (),
        not_equal : (),
    };

    type UnaryOperator = union {
        plus : (),
        minus : (),
    };

    // Operation
    type BinaryOperation = struct {
        operator : BinaryOperator,
        lhs : Ast,
        rhs : Ast
    };

    type UnaryOperation = struct {
        operator : UnaryOperator,
        operand : Ast,
    };

    type Variable = struct {
        name : Array U8,
        value : I64,
        index : U64,
        // scope : Scope, ?
    };

    type VariableValue = union {
        integer : (I64),
        string : (String),
        bool : (Bool),
    };
}