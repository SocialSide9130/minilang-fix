module Test;

import Lex;
import Token;
import Parse;
import Ast;
import Minilib.Monad.Reader;
import Minilib.Monad.Result;

namespace Test {
    run_tokenize : Array U8 -> Array Token::Token;
    run_tokenize = |code| (
        let initial_state = Lex::LexerState {
            index : 0,
            position : (1, 1),
            mode : LexerMode::normal(),
        };

        let lexer = Lex::tokenize.run_reader_t(code);
        let (_, tokens) = (lexer.@run)(initial_state);

        tokens
    );

    run_expr : Array Token::Token -> Result ErrMsg Ast::Ast;
    run_expr = |tokens| (
        let initial_state = Parse::ParserState {
            index : 0,
        };

        let parser_base = Parse::expr.run_result_t;
        let parser = parser_base.run_reader_t(tokens);
        let (_, result) = (parser.@run)(initial_state);

        result
    );

    tokenize_and_parse : Array U8 -> Result ErrMsg Ast::Ast;
    tokenize_and_parse = |code| (
        run_expr(run_tokenize(code))
    );
}

test : IO ();
test = (
    let code : Array U8 = [
        'f', 'o', 'o',
        ' ',
        '+',
        ' ',
        '1', '2', '3',
        0_U8
    ];

    let tokens = Test::run_tokenize(code);

    assert_eq(|_| "", tokens.@size, 4);;

    assert_eq(|_| "", tokens.@(0).@kind.is_identifier, true);;
    assert_eq(|_| "", tokens.@(1).@kind.is_plus, true);;
    assert_eq(|_| "", tokens.@(2).@kind.is_number_literal, true);;
    assert_eq(|_| "", tokens.@(2).@kind.as_number_literal, 123);;
    assert_eq(|_| "", tokens.@(3).@kind.is_eof, true);;

    let result = Test::tokenize_and_parse([
        '1',
        '+',
        '2',
        '*',
        '3',
        0_U8
    ]);

    assert_eq(|_| "", result.is_ok, true);;

    let ast = result.as_ok;

    // root: 1 + (2 * 3)
    assert_eq(|_| "", ast.is_binary_operation, true);;

    let add_op = ast.as_binary_operation;

    assert_eq(|_| "", add_op.@operator.is_add, true);;

    // lhs = 1
    assert_eq(|_| "", add_op.@lhs.is_number, true);;
    assert_eq(|_| "", add_op.@lhs.as_number, 1);;

    // rhs = 2 * 3
    assert_eq(|_| "", add_op.@rhs.is_binary_operation, true);;

    let mul_op = add_op.@rhs.as_binary_operation;

    assert_eq(|_| "", mul_op.@operator.is_mul, true);;

    assert_eq(|_| "", mul_op.@lhs.is_number, true);;
    assert_eq(|_| "", mul_op.@lhs.as_number, 2);;

    assert_eq(|_| "", mul_op.@rhs.is_number, true);;
    assert_eq(|_| "", mul_op.@rhs.as_number, 3);;

    pure()
);