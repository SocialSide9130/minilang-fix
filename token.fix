module Token;

namespace Token {
    type Token = struct { index : I64, pos : (I64, I64), len : I64, kind : TokenKind };
    type TokenKind = union {
        number_literal : I64,
        identifier : String,
        equal : (),
        plus : (),
        minus : (),
        asterisk : (),
        slash : (),
        open_paren : (),
        close_paren : (),
        comma : (),
        double_quote : (),
        sharp : (),
    };
}