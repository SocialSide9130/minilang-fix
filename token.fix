module Token;

namespace Token {
    type Token = struct { index : I64, position : (I64, I64), len : I64, kind : TokenKind };

    type TokenKind = union {
        number_literal : I64,
        identifier : Array U8,
        equal : (),
        plus : (),
        minus : (),
        asterisk : (),
        slash : (),
        percent : (),
        less : (),
        less_or_equal : (),
        greater : (),
        greater_or_equal : (),
        double_equal : (),
        exclamation_equal : (),
        open_paren : (),
        close_paren : (),
        comma : (),
        double_quote : (),
        sharp : (),
        invalid : (),
        eof : (),
    };

    impl TokenKind : ToString {
        to_string = |kind| match kind {
            number_literal(_) => "number",
            identifier(_) => "identifier",
            equal(_) => "'='",
            plus(_) => "'+'",
            minus(_) => "'-'",
            asterisk(_) => "'*'",
            slash(_) => "'/'",
            percent(_) => "'%'",
            less(_) => "'<'",
            less_or_equal(_) => "'<='",
            greater(_) => "'>'",
            greater_or_equal(_) => "'>='",
            double_equal(_) => "'=='",
            exclamation_equal(_) => "'!='",
            open_paren(_) => "'('",
            close_paren(_) => "')'",
            comma(_) => "','",
            double_quote(_) => "\"",
            sharp(_) => "'#'",
            invalid(_) => "invalid token",
            eof(_) => "'EOF'",
        };
    }
}